# Fournie automatiquement par l'intégration Neon <-> Vercel
DATABASE_URL=postgres://user:password@host/db
# Optionnel : secret de session (sinon généré et stocké en base au premier lancement)
AUTH_SECRET=
# Optionnel : stockage des photos sur Vercel Blob (sinon stockage en base)
BLOB_READ_WRITE_TOKEN=
# Optionnel : lecture automatique des BL
ANTHROPIC_API_KEY=
